        {
             "label": "Watch Client",
             // "dependsOn":"Sleepdelay",
             "command": "dotnet",
             "args": [ "fable", "watch", "-o", "output", "-s", "--run", "npx", "vite" ],
            "type": "shell",
            "options": {
                 "cwd": "${workspaceFolder}/src/client",
                 "env": {
                     "vsCodeSession": "true",
                 }
             },
             "group": "build",
             "isBackground": true,
             // This task is run before some debug tasks.
            // Problem is, it's a watch script, and since it never exits, VSCode
             // complains. All this is needed so VSCode just lets it run.
             "problemMatcher": [
                 {
                 "pattern": [
                     {
                    "regexp": ".",
                     "file": 1,
                     "location": 2,
                     "message": 3
                     }
                 ],
                 "background": {
                     "activeOnStart": true,
                     "beginsPattern": ".",
                     "endsPattern": ".",
                 }
                 }
             ]
        }
    ]
}